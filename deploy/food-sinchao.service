[Unit]
Description=Sin Chao restaurant web service
After=network.target postgresql.service

[Service]
Type=simple
User=food-sinchao
Group=food-sinchao
WorkingDirectory=/opt/food-sinchao/current
EnvironmentFile=/etc/food-sinchao.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=384M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
