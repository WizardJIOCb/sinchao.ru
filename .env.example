DATABASE_URL=postgresql://vietnam:password@127.0.0.1:5432/vietnam
PORT=3187
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# Online table payments stay disabled until the restaurant connects YooKassa.
YOOKASSA_ENABLED=false
# Sandbox payments are accepted only against a database whose name ends in _test.
YOOKASSA_TEST_MODE=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Set external only after the restaurant's external cash-register process is ready.
YOOKASSA_RECEIPT_MODE=
